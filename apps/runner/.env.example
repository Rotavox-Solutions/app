# RadioDJ MariaDB (read-only credentials recommended for M0)
RADIODJ_DB_HOST=
RADIODJ_DB_PORT=3306
RADIODJ_DB_USER=
RADIODJ_DB_PASSWORD=
RADIODJ_DB_NAME=

# RadioDJ REST plugin
RADIODJ_REST_HOST=127.0.0.1
RADIODJ_REST_PORT=
RADIODJ_REST_AUTH_KEY=

# How the Runner reaches Rotavox (ADR-0004). Set BOTH of these to use the Runner API:
# make the key in Rotavox under Station > Library & Runner > Runner connection, which
# also shows the address. On a box where the web app runs too, the address is
# http://127.0.0.1:3000.
ROTAVOX_API_URL=
ROTAVOX_RUNNER_KEY=

# Direct mode, used only while the two above are empty: the Runner reads Rotavox's
# Postgres itself, as before the API existed. Kept so a box can switch back by clearing
# the two lines above and restarting.
DATABASE_URL=postgresql://rotavox:rotavox@localhost:5432/rotavox
# uuid of this station's row in the `stations` table
SCHEDULER_STATION_ID=

# Optional: path to the pace loop's heartbeat file, read by the independent watchdog
# (src/watchdog.ts). Defaults to ./runner.heartbeat (relative to CWD) if unset — set
# this explicitly when the pacer and watchdog run as separate systemd services with
# different working directories.
RUNNER_HEARTBEAT_PATH=

# Optional: where the pacer keeps its copy of the logs and the reports waiting to reach
# Rotavox (ADR-0004 §6). Defaults to ./runner-state.json. Deleting it is safe while
# Rotavox is reachable: the next start fetches a fresh copy.
RUNNER_STATE_PATH=
