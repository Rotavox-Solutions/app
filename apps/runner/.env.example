# RadioDJ MariaDB (read-only credentials recommended for M0)
RADIODJ_DB_HOST=
RADIODJ_DB_PORT=3306
RADIODJ_DB_USER=
RADIODJ_DB_PASSWORD=
RADIODJ_DB_NAME=

# RadioDJ REST plugin
RADIODJ_REST_HOST=127.0.0.1
RADIODJ_REST_PORT=
RADIODJ_REST_AUTH_KEY=

# Scheduler's own Postgres (see /packages/schema)
DATABASE_URL=postgresql://rotavox:rotavox@localhost:5432/rotavox
# uuid of this Runner's row in the `stations` table (single-station for now)
SCHEDULER_STATION_ID=
