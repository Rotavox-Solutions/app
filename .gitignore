.env
node_modules/
dist/
.pgdata/
*.tsbuildinfo

# Raw listener logs. Contain client IP addresses and are large; the digest
# emitted by tools/analyze-listeners.py is the artifact that gets committed,
# and it never carries a raw address.
.logs/
*.access.log
access*.log
access*.log.gz
__pycache__/
*.py[co]
# Editor swap files — a crash mid-edit on .env would put credentials in one.
.*.sw[nop]
..*.sw[nop]
*.swp
